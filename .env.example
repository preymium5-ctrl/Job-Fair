# Local development: copy to .env.local. No public default administrator exists.
# Also allows a local `next start` preview; do NOT enable this on a real deployment.
CHAPTER_LOCAL_MODE=true
APP_ORIGIN=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Set a confirmed recruitment contact when provided by the operator.
# NEXT_PUBLIC_CONTACT_EMAIL=
# Keep examples out of search engines. Enable only for verified live content.
INDEX_SITE=false
# DATA_DIR=F:/JOB ORDER WEBSITE PH/.data

# Production: remove CHAPTER_LOCAL_MODE or set it false. All values below are required.
# DATABASE_URL=postgresql://username:password@host:5432/chapter?sslmode=require
# APP_ORIGIN=https://your-confirmed-domain.example
# Generate with: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
# SESSION_SECRET=replace-with-at-least-32-random-characters

# Private S3-compatible bucket. Disable public access; NEVER expose resumes with a bucket URL.
# S3_BUCKET=chapter-private
# S3_REGION=ap-southeast-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=https://optional-compatible-object-storage-endpoint
# S3_FORCE_PATH_STYLE=false

# Only true behind a trusted reverse proxy that overwrites X-Forwarded-For.
# Otherwise rate limits share one conservative bucket for all requests.
TRUST_PROXY=false
# Automatic application delivery: deploy the signed Apps Script receiver first.
# See docs/GOOGLE_SHEETS_SETUP.md. Keep the secret server-only.
# GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
# GOOGLE_SHEETS_WEBHOOK_SECRET=at-least-32-random-characters-matching-script-properties
# Proposed roles seed automatically in local mode, once per catalog version.
# Production starts with no vacancies unless the proposed catalog is explicitly enabled.
SEED_PROPOSED_JOBS=false
# Legacy alias; prefer SEED_PROPOSED_JOBS for the current catalog.
SEED_EXAMPLE_JOBS=false

# Optional for non-interactive `npm run admin:setup` only; remove after provisioning.
# ADMIN_SETUP_EMAIL=
# ADMIN_SETUP_PASSWORD=
