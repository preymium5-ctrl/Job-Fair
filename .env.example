# Local development: copy to .env.local. No public default administrator exists.
# Also allows a local `next start` preview; do NOT enable this on a real deployment.
CHAPTER_LOCAL_MODE=true
APP_ORIGIN=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Set a confirmed recruitment contact when provided by the operator.
# NEXT_PUBLIC_CONTACT_EMAIL=
# Local mode and Vercel previews always stay out of search engines.
# For the public production site, set INDEX_SITE=true (false explicitly pauses indexing).
INDEX_SITE=false
# Optional Search Console HTML-tag verification: use only the content attribute value.
# GOOGLE_SITE_VERIFICATION=
# DATA_DIR=F:/JOB ORDER WEBSITE PH/.data

# Production: set CHAPTER_LOCAL_MODE=false and choose one application storage mode.
# Both modes require the exact public origin. Redeploy after changing environment values.
# APP_ORIGIN=https://www.jobsincroatiaa.com
# NEXT_PUBLIC_SITE_URL=https://www.jobsincroatiaa.com

# Google Sheets mode: private Google Drive stores uploads; no database/S3 is required.
# Staff review applications in the private Google Sheet and Drive folder.
# A reference is confirmed only after Google's matching success acknowledgement.
# APPLICATION_STORAGE=google-sheets
# GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
# GOOGLE_SHEETS_WEBHOOK_SECRET=at-least-32-random-characters-matching-script-properties

# Database mode (the default): required for the website's staff workspace.
# APPLICATION_STORAGE=database
# DATABASE_URL=postgresql://username:password@host:5432/chapter?sslmode=require
# Generate with: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
# SESSION_SECRET=replace-with-at-least-32-random-characters

# Private S3-compatible bucket. Disable public access; NEVER expose resumes with a bucket URL.
# S3_BUCKET=chapter-private
# S3_REGION=ap-southeast-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=https://optional-compatible-object-storage-endpoint
# S3_FORCE_PATH_STYLE=false

# Only true behind a trusted reverse proxy that overwrites X-Forwarded-For.
# Otherwise rate limits share one conservative bucket for all requests.
TRUST_PROXY=false
# The same Google credentials optionally enable queued exports in database mode.
# Deploy the signed Apps Script receiver first; see docs/GOOGLE_SHEETS_SETUP.md.
# Never put the webhook secret in a NEXT_PUBLIC_ variable.
# Proposed roles seed automatically in local mode, once per catalog version.
# Production starts with no vacancies unless the proposed catalog is explicitly enabled.
SEED_PROPOSED_JOBS=false
# Legacy alias; prefer SEED_PROPOSED_JOBS for the current catalog.
SEED_EXAMPLE_JOBS=false

# Optional for non-interactive `npm run admin:setup` only; remove after provisioning.
# ADMIN_SETUP_EMAIL=
# ADMIN_SETUP_PASSWORD=
